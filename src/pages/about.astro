---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import AboutIntro from "@components/pages/about/AboutIntro.astro";
import AboutJourney from "@components/pages/about/AboutJourney.astro";
import AboutProfile from "@components/pages/about/AboutProfile.astro";
import { Icon } from "astro-icon/components";
import { aboutConfig, profileConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAuthorAvatarUrl } from "@/utils/schema-image";
import { buildProfilePage } from "@/utils/schema-utils";

const aboutPost = await getEntry("spec", "about");
const { Content } = aboutPost ? await render(aboutPost) : { Content: null };
const avatarUrl = await getAuthorAvatarUrl();
const jsonLd = buildProfilePage({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: Astro.url.toString(),
	avatarUrl,
	description: profileConfig.bio,
});
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	{aboutConfig.enable && <div class="about-page mx-auto flex w-full max-w-4xl flex-col gap-2">
		{aboutConfig.modules.profile && <AboutProfile />}
		{aboutConfig.modules.intro && <AboutIntro />}
		{aboutConfig.modules.skills && aboutConfig.skills.length > 0 && <section class="card-base p-6 sm:p-8"><p class="mb-4 text-xs font-medium text-neutral-500 opacity-80 dark:text-neutral-400">技能与工具</p><div class="flex flex-wrap gap-2">{aboutConfig.skills.map((skill) => <span class="inline-flex max-w-full items-center gap-2 rounded-full border border-black/10 bg-black/5 px-3 py-2 text-sm text-neutral-700 dark:border-white/10 dark:bg-white/10 dark:text-neutral-200"><Icon name={skill.icon || "fa7-solid:code"} class="shrink-0 text-base" /> <span class="break-words">{skill.name}</span></span>)}</div></section>}
		{aboutConfig.modules.journey && <AboutJourney>{Content ? <Markdown class="mt-4"><Content /></Markdown> : <p class="mt-4 text-neutral-500 dark:text-neutral-400">暂无内容。</p>}</AboutJourney>}
	</div>}
</MainGridLayout>

<style is:global>
	@media (min-width: 1300px) {
		.about-page > * {
			animation: about-slide-in 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
		}
		.about-page > :nth-child(2) {
			animation-delay: 0.1s;
		}
		.about-page > :nth-child(3) {
			animation-delay: 0.2s;
		}
		.about-page > :nth-child(4) {
			animation-delay: 0.3s;
		}
	}
	@keyframes about-slide-in {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.about-page > * {
			animation: none;
		}
	}
</style>

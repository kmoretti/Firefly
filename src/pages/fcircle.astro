---
import FcircleFeed from "@/components/pages/fcircle/FcircleFeed.svelte";
import { fcircleConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.fcircle || !fcircleConfig.enable) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.fcircle);
const description = i18n(I18nKey.fcircleDescription);
const externalUrl = new URL(fcircleConfig.articleApiUrl).origin;
const itemsPerPage = Math.max(1, fcircleConfig.itemsPerPage);
---

<MainGridLayout title={title} description={description}>
	<section class="fcircle-page" aria-labelledby="fcircle-page-title">
		<header class="card-base w-full px-6 py-6 sm:px-9">
			<div class="flex items-center gap-3">
				<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-(--primary) text-white dark:text-black/70">
					<span class="text-xl">●</span>
				</div>
				<h1 id="fcircle-page-title" class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
					{title}
				</h1>
			</div>
			{description && <p class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">{description}</p>}
		</header>
		<FcircleFeed
			client:load
			articlesUrl={url("/api/fcircle-articles.json")}
			linksUrl={url("/api/fcircle-links.json")}
			{externalUrl}
			{itemsPerPage}
			showStatus={fcircleConfig.showStatus}
			loadingText={i18n(I18nKey.fcircleLoading)}
			emptyText={i18n(I18nKey.fcircleEmpty)}
			errorText={i18n(I18nKey.fcircleError)}
			errorDesc={i18n(I18nKey.fcircleErrorDesc)}
			openExternalText={i18n(I18nKey.fcircleOpenExternal)}
			retryText={i18n(I18nKey.fcircleRetry)}
			reachableText={i18n(I18nKey.fcircleReachable)}
			unreachableText={i18n(I18nKey.fcircleUnreachable)}
			latencyText={i18n(I18nKey.fcircleLatency)}
			crawlableText={i18n(I18nKey.fcircleCrawlable)}
			noCrawlText={i18n(I18nKey.fcircleNoCrawl)}
		/>
	</section>
</MainGridLayout>

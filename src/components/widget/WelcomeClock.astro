<script
	is:inline
	define:vars={{
		qweatherKey,
		apiHost,
		defaultCity,
		locationId,
		timezone,
	}}
>
	(() => {
		const WEEK = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];

		const zeroPadding = (num, d) => ("0".repeat(d) + num).slice(-d);

		const getIconColor = (icon) => {
			switch (icon) {
				case "100":
					return "#fdcc45";
				case "101":
					return "#fe6976";
				case "102":
				case "103":
					return "#fe7f5b";
				case "104":
				case "150":
				case "151":
				case "152":
				case "153":
				case "154":
				case "800":
				case "801":
				case "802":
				case "803":
				case "804":
				case "805":
				case "806":
				case "807":
					return "#2152d1";
				case "300":
				case "301":
				case "305":
				case "306":
				case "307":
				case "308":
				case "309":
				case "310":
				case "311":
				case "312":
				case "313":
				case "314":
				case "315":
				case "316":
				case "317":
				case "318":
				case "350":
				case "351":
				case "399":
					return "#49b1f5";
				case "302":
				case "303":
				case "304":
					return "#fdcc46";
				case "400":
				case "401":
				case "402":
				case "403":
				case "404":
				case "405":
				case "406":
				case "407":
				case "408":
				case "409":
				case "410":
				case "456":
				case "457":
				case "499":
					return "#a3c2dc";
				case "500":
				case "501":
				case "502":
				case "503":
				case "504":
				case "507":
				case "508":
				case "509":
				case "510":
				case "511":
				case "512":
				case "513":
				case "514":
				case "515":
					return "#97acba";
				case "900":
				case "999":
					return "red";
				case "901":
					return "#179fff";
				default:
					return "#fdcc45";
			}
		};

		const startClock = (box, tz) => {
			if (box.dataset.clockRunning === "true") return;
			box.dataset.clockRunning = "true";

			const updateTime = () => {
				const timeEl = box.querySelector("#card-clock-time");
				const dateEl = box.querySelector("#card-clock-clockdate");
				const ampmEl = box.querySelector("#card-clock-dackorlight");
				if (!timeEl || !dateEl || !ampmEl) return;

				const now = new Date();
				const cd = new Date(
					now.toLocaleString("en-US", { timeZone: tz, hour12: false }),
				);

				timeEl.textContent = `${zeroPadding(cd.getHours(), 2)}:${zeroPadding(cd.getMinutes(), 2)}:${zeroPadding(cd.getSeconds(), 2)}`;
				dateEl.textContent = `${cd.getFullYear()}-${zeroPadding(cd.getMonth() + 1, 2)}-${zeroPadding(cd.getDate(), 2)} ${WEEK[cd.getDay()]}`;
				ampmEl.textContent = cd.getHours() >= 12 ? "P M" : "A M";
			};

			updateTime();
			const timer = setInterval(updateTime, 1000);

			document.addEventListener(
				"astro:before-swap",
				() => {
					clearInterval(timer);
					box.dataset.clockRunning = "false";
				},
				{ once: true },
			);
		};

		const renderClock = (box, info, city, tz) => {
			const color = getIconColor(info.now.icon);
			box.innerHTML = `
				<div class="clock-row">
					<span id="card-clock-clockdate" class="card-clock-clockdate"></span>
					<span class="card-clock-weather"><i class="qi-${info.now.icon}-fill" style="color: ${color}"></i> ${info.now.text} <span>${info.now.temp}</span> ℃</span>
					<span class="card-clock-humidity">💧 ${info.now.humidity}%</span>
				</div>
				<div class="clock-row">
					<span id="card-clock-time" class="card-clock-time"></span>
				</div>
				<div class="clock-row">
					<span class="card-clock-windDir"><i class="qi-gale"></i> ${info.now.windDir}</span>
					<span class="card-clock-location">${city}</span>
					<span id="card-clock-dackorlight" class="card-clock-dackorlight"></span>
				</div>
			`;
			startClock(box, tz);
		};

		const renderFallback = (box, city, tz) => {
			box.innerHTML = `
				<div class="clock-row">
					<span id="card-clock-clockdate" class="card-clock-clockdate"></span>
					<span class="card-clock-weather"></span>
					<span class="card-clock-humidity"></span>
				</div>
				<div class="clock-row">
					<span id="card-clock-time" class="card-clock-time"></span>
				</div>
				<div class="clock-row">
					<span class="card-clock-windDir"></span>
					<span class="card-clock-location">${city}</span>
					<span id="card-clock-dackorlight" class="card-clock-dackorlight"></span>
				</div>
			`;
			startClock(box, tz);
		};

		const fetchWeather = async (box) => {
			if (!qweatherKey) {
				renderFallback(box, defaultCity, timezone);
				return;
			}

			try {
				let locId = locationId;
				let tz = timezone;
				let city = defaultCity;

				if (!locId && defaultCity) {
					const geoRes = await fetch(
						`${apiHost}/geo/v2/city/lookup?location=${encodeURIComponent(defaultCity)}&key=${qweatherKey}`,
					);
					const geoData = await geoRes.json();
					const loc = geoData.location?.[0];
					if (!loc) throw new Error("geo lookup failed");
					locId = loc.id;
					tz = loc.tz || timezone;
					city = loc.name || defaultCity;
				}

				if (!locId) {
					renderFallback(box, city, tz);
					return;
				}

				const weatherRes = await fetch(
					`${apiHost}/v7/weather/now?location=${locId}&key=${qweatherKey}`,
				);
				const weatherData = await weatherRes.json();
				if (!weatherData.now) throw new Error("weather fetch failed");

				renderClock(box, weatherData, city, tz);
			} catch (err) {
				console.error("[WelcomeClock] 获取天气失败:", err);
				renderFallback(box, defaultCity, timezone);
			}
		};

		const init = () => {
			const box = document.getElementById("welcome-clock-box");
			if (!box) return;
			if (box.dataset.clockRunning === "true") return;
			fetchWeather(box);
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init, { once: true });
		} else {
			init();
		}

		document.addEventListener("astro:page-load", init);
	})();
</script>

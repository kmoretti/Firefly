---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { welcomeClockConfig } from "@/config/welcomeClockConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const config = welcomeClockConfig;
const showTitle = widgetConfig?.showTitle !== false;

const qweatherKey = import.meta.env.PUBLIC_QWEATHER_KEY ?? "";
const apiHost = config.apiHost ?? "https://devapi.qweather.com";
const defaultCity = config.defaultCity ?? "";
const locationId = config.locationId ?? "";
const timezone = config.timezone ?? "Asia/Shanghai";
---

<WidgetLayout
	name={config.title || i18n(I18nKey.welcomeClock)}
	showTitle={showTitle}
	id="welcome-clock"
	class={className}
	style={style}
>
	<div class="welcome-clock-background">
		<div id="welcome-clock-box" class="welcome-clock-box">
			<div class="welcome-clock-loading">
				<span class="welcome-clock-loading-dot"></span>
				<span class="welcome-clock-loading-dot"></span>
				<span class="welcome-clock-loading-dot"></span>
			</div>
		</div>
	</div>
</WidgetLayout>

<style>
	@font-face {
		font-family: "UnidreamLED";
		src: url("/fonts/UniDreamLED.ttf") format("truetype");
		font-display: swap;
	}

	@font-face {
		font-family: "qweather-icons";
		src:
			url("/fonts/qweather-icons.woff2") format("woff2"),
			url("/fonts/qweather-icons.woff") format("woff"),
			url("/fonts/qweather-icons.ttf") format("truetype");
		font-display: swap;
	}

	.welcome-clock-background {
		background-color: var(--btn-regular-bg);
		border-radius: 8px;
		box-shadow: inset 0 0 4px 2px rgb(145 148 154 / 40%);
		padding: 12px 14px;
		min-height: 110px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.welcome-clock-box {
		width: 100%;
		font-family: "UnidreamLED", monospace;
		font-weight: 400;
		color: #000;
	}

	:global(:root.dark) .welcome-clock-box,
	:global(html[data-theme="one-dark-pro"]) .welcome-clock-box {
		color: #fff;
	}

	.welcome-clock-loading {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 6px;
		height: 84px;
	}

	.welcome-clock-loading-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: currentColor;
		opacity: 0.4;
		animation: welcome-clock-blink 1.2s infinite ease-in-out both;
	}

	.welcome-clock-loading-dot:nth-child(1) {
		animation-delay: -0.32s;
	}

	.welcome-clock-loading-dot:nth-child(2) {
		animation-delay: -0.16s;
	}

	@keyframes welcome-clock-blink {
		0%,
		80%,
		100% {
			opacity: 0.2;
			transform: scale(0.8);
		}
		40% {
			opacity: 1;
			transform: scale(1);
		}
	}

	:global(.clock-row) {
		font-family: "UnidreamLED", monospace;
		font-weight: 400;
		display: flex;
		justify-content: space-between;
		flex-wrap: nowrap;
		white-space: nowrap;
		align-items: center;
	}

	:global(.card-clock-clockdate),
	:global(.card-clock-ip) {
		text-align: left;
	}

	:global(.card-clock-weather),
	:global(.card-clock-location),
	:global(.card-clock-windDir) {
		font-family: "UnidreamLED", monospace;
		font-size: 14px;
	}

	:global(.card-clock-location),
	:global(.card-clock-weather) {
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
		display: inline-block;
		vertical-align: middle;
	}

	:global(.card-clock-dackorlight),
	:global(.card-clock-humidity) {
		text-align: right;
		font-size: 14px;
	}

	:global(.card-clock-time) {
		flex: 1;
		font-family: "UnidreamLED", monospace;
		font-size: 38px;
		text-align: center;
		line-height: 1.5;
		letter-spacing: 2px;
	}

	@media screen and (max-width: 1086px) {
		:global(.card-clock-humidity) {
			display: none;
		}
	}

	/* QWeather Icons (https://icons.qweather.com) - CC BY 4.0 */

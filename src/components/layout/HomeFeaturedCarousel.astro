---
import { Icon } from "astro-icon/components";

// 首页「喜欢哪一篇推荐呢~」推荐文章轮播：posts 由父组件完成筛选/截取/补齐后传入，
// posts 为空时整块不渲染。桌面端每屏 visibleCount 张卡片，移动端（≤767px）每屏 2 张、横滑浏览。
interface Props {
	posts: { title: string; url: string; cover: string; description: string }[];
	title?: string; // 标题文案，默认「喜欢哪一篇推荐呢~」
	visibleCount?: number; // 桌面端同时可见卡片数，默认 4
}

const { posts, title = "喜欢哪一篇推荐呢~", visibleCount = 4 } = Astro.props;
---

{posts.length > 0 && (
	<section class="home-featured" data-home-featured aria-label="推荐文章">
		<div class="home-featured__inner">
			<div class="home-featured__header">
				<h2 class="home-featured__heading">
					<Icon name="mdi:star-outline" aria-hidden="true" />
					{title}
				</h2>
				<div class="home-featured__navs" data-home-featured-navs>
					<button
						type="button"
						class="btn-plain home-featured__nav"
						data-home-featured-prev
						aria-label="上一组文章"
					>
						<Icon name="mdi:chevron-left" class="text-lg" aria-hidden="true" />
					</button>
					<button
						type="button"
						class="btn-plain home-featured__nav"
						data-home-featured-next
						aria-label="下一组文章"
					>
						<Icon name="mdi:chevron-right" class="text-lg" aria-hidden="true" />
					</button>
				</div>
			</div>
			<div class="home-featured__viewport" data-home-featured-viewport>
				<div class="home-featured__track">
					{posts.map((post) => (
						<a
							class="home-featured-card"
							href={post.url}
							aria-label={`阅读全文：${post.title}`}
						>
							<div class="home-featured-card__cover">
								<img
									src={post.cover}
									alt={post.title}
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="home-featured-card__body">
								<h3 class="home-featured-card__title text-90">{post.title}</h3>
								{post.description && (
									<p class="home-featured-card__excerpt text-75">
										{post.description}
									</p>
								)}
							</div>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>
)}

<style define:vars={{ featuredVisible: visibleCount, featuredGap: "12px" }}>
	/* 结构与外观对照参考站 home-list-featured，配色/圆角换成本站主题变量 */
	.home-featured {
		width: 100%;
		min-width: 0;
	}

	.home-featured__inner {
		padding: 10px 12px 12px;
	}

	.home-featured__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 8px;
	}

	.home-featured__heading {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1;
		color: var(--primary);
	}

	.home-featured__navs {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex-shrink: 0;
	}

	/* 卡片数不足一屏时脚本会加 hidden；显式覆盖，避免被 display: inline-flex 顶掉 */
	.home-featured__navs[hidden] {
		display: none;
	}

	.home-featured__nav {
		width: 30px;
		height: 30px;
		padding: 0;
		border: none;
		border-radius: 9999px;
	}

	/* 隐藏横向滚动条但保持可滚动 */
	.home-featured__viewport {
		width: 100%;
		min-width: 0;
		padding-top: 6px;
		padding-bottom: 10px;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-ms-overflow-style: none;
		touch-action: pan-x pan-y;
	}

	.home-featured__viewport::-webkit-scrollbar {
		display: none;
	}

	.home-featured__track {
		display: flex;
		gap: var(--featuredGap);
		padding-inline: 2px;
	}

	.home-featured-card {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		flex: 0 0
			calc(
				(100% - (var(--featuredVisible) - 1) * var(--featuredGap)) /
					var(--featuredVisible)
			);
		min-width: 0;
		scroll-snap-align: start;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--line-color);
		border-radius: var(--radius-large);
		overflow: hidden;
		background: var(--card-bg);
		box-shadow:
			0 3px 8px rgb(0 0 0 / 8%),
			0 1px 3px rgb(0 0 0 / 5%);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.home-featured-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--primary) 45%, var(--line-color));
		box-shadow:
			0 5px 12px rgb(0 0 0 / 10%),
			0 1px 4px rgb(0 0 0 / 6%);
	}

	.home-featured-card:hover .home-featured-card__title {
		color: var(--primary);
	}

	.home-featured-card__cover {
		flex: none;
		width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 0;
		overflow: hidden;
		background: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
	}

	.home-featured-card__cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home-featured-card__body {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 4px;
		padding: 10px 10px 11px;
		min-width: 0;
	}

	.home-featured-card__title {
		display: block;
		margin: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.3;
		transition: color 0.2s ease;
	}

	/* 摘要最多两行截断 */
	.home-featured-card__excerpt {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		font-size: 0.6875rem;
		line-height: 1.4;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	/* 减少动效偏好：关闭 hover 上浮过渡（滚动行为由脚本按该偏好切换） */
	@media (prefers-reduced-motion: reduce) {
		.home-featured-card,
		.home-featured-card__title {
			transition: none;
		}

		.home-featured-card:hover {
			transform: none;
		}
	}

	/* 移动端（≤767px）：每屏 2 张卡片、收窄内边距；视口本身支持横滑与触摸翻页 */
	@media (max-width: 767px) {
		.home-featured__inner {
			padding: 8px 10px 10px;
		}

		.home-featured__heading {
			font-size: 0.9375rem;
		}

		.home-featured-card {
			flex: 0 0 calc((100% - var(--featuredGap)) / 2);
		}

		.home-featured-card__body {
			padding: 8px 8px 9px;
		}
	}
</style>

<script>
	// 首页精选轮播交互：模块脚本整站只执行一次，
	// swup 切页后由 @swup/astro 派发的 astro:page-load 重新初始化。
	// 记录上一轮的清理函数，重复触发时先解绑，避免 resize 等全局监听越积越多。
	let cleanup: (() => void) | undefined;

	function initHomeFeaturedCarousel(): void {
		cleanup?.();
		cleanup = undefined;

		// 用 data 属性定位，不依赖全局 id
		const root = document.querySelector<HTMLElement>("[data-home-featured]");
		const viewport = root?.querySelector<HTMLElement>(
			"[data-home-featured-viewport]",
		);
		const track = root?.querySelector<HTMLElement>(".home-featured__track");
		const navs = root?.querySelector<HTMLElement>("[data-home-featured-navs]");
		const prev = root?.querySelector<HTMLButtonElement>(
			"[data-home-featured-prev]",
		);
		const next = root?.querySelector<HTMLButtonElement>(
			"[data-home-featured-next]",
		);
		if (!root || !viewport || !track || !navs || !prev || !next) return;

		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		// 步长 = 卡片宽 + 轨道间距；点击时实时读取，窗口尺寸变化后自然取到新值
		const getStep = (): number => {
			const card = track.querySelector<HTMLElement>(".home-featured-card");
			if (!card) return 0;
			const gap = Number.parseFloat(getComputedStyle(track).gap) || 0;
			return card.offsetWidth + gap;
		};

		// 卡片数不超过可见数（滚动宽度不超出）时隐藏整组按钮
		const updateNavs = (): void => {
			if (viewport.scrollWidth <= viewport.clientWidth + 1) {
				navs.setAttribute("hidden", "");
				viewport.scrollLeft = 0;
				return;
			}
			navs.removeAttribute("hidden");
		};

		const scrollByStep = (direction: number): void => {
			const step = getStep();
			if (!step) return;
			viewport.scrollBy({
				left: direction * step,
				behavior: reducedMotion.matches ? "auto" : "smooth",
			});
		};

		const onPrevClick = (): void => scrollByStep(-1);
		const onNextClick = (): void => scrollByStep(1);

		prev.addEventListener("click", onPrevClick);
		next.addEventListener("click", onNextClick);
		window.addEventListener("resize", updateNavs, { passive: true });
		updateNavs();

		cleanup = () => {
			prev.removeEventListener("click", onPrevClick);
			next.removeEventListener("click", onNextClick);
			window.removeEventListener("resize", updateNavs);
			viewport.scrollLeft = 0;
		};
	}

	// 模块脚本按 defer 语义执行，首屏 DOM 已就绪；切页后 astro:page-load 再走同一入口
	initHomeFeaturedCarousel();
	document.addEventListener("astro:page-load", initHomeFeaturedCarousel);
</script>
